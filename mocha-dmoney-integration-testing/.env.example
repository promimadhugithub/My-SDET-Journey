# Copy this file to `.env` and adjust the values for your local dMoney server.
BASE_URL=http://localhost:5000

# Partner key sent as the X-AUTH-SECRET-KEY header (must match the backend's PARTNER_KEY)
SECRET_KEY=ROADTOSDET

# Admin account (creates + activates users)
ADMIN_EMAIL=admin@roadtocareer.net
ADMIN_PASSWORD=1234

# System account (source of the initial agent deposit)
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234
SYSTEM_ACCOUNT=SYSTEM
